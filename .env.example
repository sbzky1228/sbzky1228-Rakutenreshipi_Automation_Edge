# このファイルを .env という名前でコピーし、値を設定してください（.env はGitHubに上げない）
# exe で実行する場合は、RakutenRecipe_Auto_Post.exe と同じフォルダに .env を置きます

# 投稿素材（レシピごとのフォルダ）を置くフォルダ。投稿してもフォルダは移動しない
base_folder_path = "C:\Users\...\投稿素材"

# 楽天会員のユーザーID（メールアドレス）とパスワード
RAKUTEN_USER_ID = "楽天のユーザーID"
RAKUTEN_PASSWORD = "楽天のパスワード"

# 投稿履歴を記録する PostgreSQL
DB_NAME = "RakutenRecipe_information"
DB_USER = "postgres"
DB_PASSWORD = "データベースのパスワード"
DB_HOST = "localhost"
DB_PORT = "5432"

# （任意）データベースのバックアップ。保存先（未指定ならプログラムのフォルダの backup）・何日ごと・何個残すか
BACKUP_DIR = ""
BACKUP_INTERVAL_DAYS = "7"
BACKUP_KEEP = "10"
# （任意）pg_dump.exe の場所（未指定なら C:\Program Files\PostgreSQL\<版>\bin などから自動で探す）
PG_DUMP_PATH = ""

# （任意）Edgeのドライバを自動で用意できない環境（オフライン等）で使う msedgedriver.exe のパス
DRIVER_PATH = ""

# （任意）ログ・失敗時の画面の保存先。未指定ならプログラムのフォルダの logs
LOG_DIR = ""
